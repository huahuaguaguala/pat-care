<view class="container">
  <view class="card" style="text-align:center;">
    <text style="font-size:20px;">{{user ? user.nickname : '未登录'}}</text>
    <view wx:if="{{!user}}" class="btn-primary" bindtap="goLogin" style="margin-top:12px;">登录</view>
  </view>
  <view class="card" wx:if="{{user}}">
    <view bindtap="goPet" style="padding:12px 0;border-bottom:1px solid #eee;">我的宠物 ></view>
    <view bindtap="goSign" style="padding:12px 0;border-bottom:1px solid #eee;">每日签到 ></view>
    <view style="padding:12px 0;" bindtap="logout">退出登录</view>
  </view>
</view>
