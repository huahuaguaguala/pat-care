<view class="container">
  <view wx:if="{{!user}}" class="card" style="text-align:center;padding:40px;">
    <text style="font-size:18px;">未登录</text>
    <view style="margin-top:16px;">
      <view class="btn btn-primary" bindtap="goToLogin" style="margin-bottom:8px;">去登录</view>
    </view>
  </view>

  <view wx:if="{{user}}">
    <view class="card" style="text-align:center;padding:20px;">
      <text style="font-size:22px;font-weight:600;">{{user.nickname}}</text>
      <view style="margin-top:4px;"><text class="tag tag-green">{{roleText[user.role] || '用户'}}</text></view>
      <view class="text-muted" style="margin-top:4px;">{{user.phone || '未填写手机号'}}</view>
    </view>

    <view class="card">
      <view style="padding:12px 0;border-bottom:1px solid #f0f0f0;" bindtap="goToPet">我的宠物</view>
      <view style="padding:12px 0;border-bottom:1px solid #f0f0f0;" bindtap="goToOrders">我的订单</view>
      <view style="padding:12px 0;border-bottom:1px solid #f0f0f0;" bindtap="goToSign">每日签到</view>
      <view wx:if="{{user.role === 1 || user.role === 2}}" style="padding:12px 0;border-bottom:1px solid #f0f0f0;color:#1565C0;" bindtap="goToWorkbench">店员工作台</view>
    </view>

    <view class="btn btn-danger" bindtap="logout" style="width:100%;margin-top:16px;">退出登录</view>
  </view>
</view>
